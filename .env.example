# Mock MVP (default: true). Set false and configure the keys below for Supabase.
NEXT_PUBLIC_MOCK_MODE=true
# Enable production feedback screens only after feedback migrations and live QA.
FEEDBACK_UI_ENABLED=false
# Enable the production course library only after its migrations and live QA pass.
LEARNING_UI_ENABLED=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — never expose, never prefix NEXT_PUBLIC_

# Anthropic (AI report drafting)
ANTHROPIC_API_KEY=                  # SERVER ONLY — read implicitly by the Anthropic SDK
                                    # (lib/ai/reportDraft.ts never names it). If it is
                                    # missing, report drafting fails at call time, not boot.

# Google Drive (video storage)
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=  # public by design — Picker API key, scoped narrowly in Google Cloud Console
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID= # public by design — OAuth client IDs are not secrets; the browser Picker needs it
# GOOGLE_OAUTH_CLIENT_SECRET        # NOT REQUIRED. No server-side Google OAuth flow exists:
                                    # lib/drive/driveClient.ts validates a picked file with the
                                    # public API key alone and soft-fails. Skip creating a client
                                    # secret during setup; add this back only if a server-side
                                    # Drive flow is ever built.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In Vercel this MUST be the real https:// origin — it builds the magic-link and
# teacher-invite redirect targets (api/auth/magic-link, api/admin/teachers,
# api/classes/[id]/students). A wrong value sends every login link to the wrong host.
